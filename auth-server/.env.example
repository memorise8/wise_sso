AUTH_DB_ADMIN_PASSWORD="replace-postgres-admin-password"
AUTH_DB_PASSWORD="replace-auth-db-password"
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=5432
AUTH_DB_NAME="auth_db"
AUTH_DB_USER="auth_user"
AUTH_REDIS_HOST=127.0.0.1
AUTH_REDIS_PORT=6379

DATABASE_URL="postgresql://auth_user:replace-auth-db-password@localhost:5432/auth_db"

NODE_ENV="development"
PORT=4000
JWT_REFRESH_SECRET="replace-refresh-secret"
JWT_ISSUER="https://auth.temis.co.kr"
JWT_AUDIENCE="temis"
JWT_ACCESS_ALGORITHM="RS256"
# Generate a PKCS8 RSA private key for the deployment and store it with newlines escaped as \n.
JWT_ACCESS_PRIVATE_KEY="replace-with-pkcs8-rsa-private-key-escaped-newlines"
JWT_ACCESS_PUBLIC_JWK='{"kty":"RSA","n":"replace-rsa-modulus","e":"AQAB","alg":"RS256","use":"sig","kid":"temis-access-key-1"}'
JWT_ACCESS_KEY_ID="temis-access-key-1"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
PASSWORD_MIN_LENGTH=12
COMPANY_ALLOWED_EMAIL_DOMAIN=""
CORS_ALLOWED_ORIGINS="http://localhost:3000"
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Relying-client policy. Redirect URIs authorize OAuth handoff targets; origins are only for CORS.
AUTH_CLIENTS_JSON='[{"clientId":"temis","audience":"temis","allowedRedirectUris":["https://financenow.kr/auth/callback"],"allowedOrigins":["https://financenow.kr"],"defaultRole":{"serviceKey":"temis","name":"pending"}}]'
# Compose publishes PostgreSQL and Redis on loopback by default. Host-run Node uses the published Docker port.
# Use redis://redis:6379 only when the app itself runs inside Compose.
REDIS_URL="redis://127.0.0.1:6379"

# Legacy/default portal callback origin used for local portal fallback and CORS origin inclusion.
FRONTEND_REDIRECT_URL="http://localhost:3000/auth/callback"
# Keep disabled until provider client id/secret values are filled.
OAUTH_ENABLED_PROVIDERS=""

# First admin bootstrap is operational, not env-driven:
# npm run ops:grant-admin -- --email <active-user-email>

MAIL_PROVIDER="dev"
MAIL_FROM="Auth <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"

NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
NAVER_REDIRECT_URI="http://localhost:4000/auth/naver/callback"

KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
KAKAO_REDIRECT_URI="http://localhost:4000/auth/kakao/callback"
