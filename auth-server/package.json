{
  "name": "auth-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:phase0-image": "bash ops/build-phase0-image.sh",
    "test": "vitest run",
    "test:phase0-integration": "bash ops/run-phase0-integration.sh",
    "test:phase0-image-smoke": "bash ops/run-phase0-image-smoke.sh",
    "qa:auth-flow": "node scripts/qa-auth-flow.mjs",
    "start": "node dist/src/server.js",
    "tokens:cleanup": "tsx src/scripts/cleanup-refresh-tokens.ts",
    "ops:cleanup-audit-logs": "tsx src/scripts/cleanup-audit-logs.ts",
    "ops:grant-admin": "tsx src/scripts/grant-admin.ts",
    "ops:backfill-default-roles": "tsx src/scripts/backfill-default-roles.ts",
    "ops:merge-split-email-identities": "tsx src/scripts/merge-split-email-identities.ts",
    "qa:seed-temis-admin-flow": "tsx src/scripts/seed-temis-admin-flow-fixture.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "ops:backup": "bash ops/backup-auth-db.sh",
    "ops:restore-test": "bash ops/restore-test-auth-db.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "ky": "^1.7.5",
    "nodemailer": "^9.0.3",
    "redis": "^5.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.11.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
