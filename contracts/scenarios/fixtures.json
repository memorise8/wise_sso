{
  "version": 1,
  "scenarios": [
    {
      "id": "security.refresh-none-algorithm",
      "fixture": "active-user-refresh-none",
      "fixtureExpect": {
        "$allowExtra": true,
        "refreshToken": {
          "$capture": "none-token",
          "$predicate": "jwt",
          "header": { "alg": "none", "typ": "JWT" },
          "claims": {
            "sub": { "$capture": "subject", "$predicate": "uuid" },
            "type": "refresh",
            "tokenId": { "$capture": "token-id", "$predicate": "nonempty-string" },
            "audience": { "$fixture": "audience" },
            "iat": { "$capture": "issued-at", "$predicate": "timestamp" },
            "exp": { "$capture": "expires-at", "$predicate": "timestamp" }
          }
        },
        "algorithm": "none",
        "audience": { "$predicate": "nonempty-string" }
      },
      "stateProbe": "refresh-ledger",
      "request": {
        "method": "POST",
        "path": "/auth/refresh",
        "json": { "refreshToken": { "$fixture": "refreshToken" } }
      },
      "expect": {
        "status": 401,
        "json": {
          "error": { "code": "INVALID_REFRESH_TOKEN", "message": "Invalid refresh token" }
        }
      },
      "stateAssertions": [{ "type": "unchanged" }]
    },
    {
      "id": "security.refresh-hs256-rotation",
      "fixture": "active-user-refresh-hs256",
      "fixtureExpect": {
        "$allowExtra": true,
        "refreshToken": {
          "$capture": "seeded-hs256-token",
          "$predicate": "jwt",
          "header": { "alg": "HS256", "typ": "JWT" },
          "claims": {
            "sub": { "$fixture": "userId" },
            "type": "refresh",
            "tokenId": { "$capture": "seeded-token-id", "$predicate": "nonempty-string" },
            "audience": { "$fixture": "audience" },
            "iat": { "$capture": "seeded-issued-at", "$predicate": "timestamp" },
            "exp": { "$capture": "seeded-expires-at", "$predicate": "timestamp" }
          }
        },
        "algorithm": "HS256",
        "audience": { "$predicate": "nonempty-string" }
      },
      "stateProbe": "refresh-ledger",
      "request": {
        "method": "POST",
        "path": "/auth/refresh",
        "json": { "refreshToken": { "$fixture": "refreshToken" } }
      },
      "expect": {
        "status": 200,
        "json": {
          "accessToken": { "$capture": "rotated-access-token", "$predicate": "jwt" },
          "refreshToken": {
            "$capture": "rotated-refresh-token",
            "$predicate": "jwt",
            "header": { "alg": "HS256", "typ": "JWT" },
            "claims": {
              "sub": { "$fixture": "userId" },
              "type": "refresh",
              "tokenId": { "$capture": "rotated-token-id", "$predicate": "nonempty-string" },
              "audience": { "$fixture": "audience" },
              "iat": { "$capture": "rotated-issued-at", "$predicate": "timestamp" },
              "exp": { "$capture": "rotated-expires-at", "$predicate": "timestamp" }
            }
          }
        }
      },
      "assertions": [
        {
          "type": "jwt-rs256-jwks",
          "tokenPath": "$.json.accessToken",
          "jwksPath": "/.well-known/jwks.json",
          "claims": {
            "sub": { "$fixture": "userId" },
            "email": { "$fixture": "email" },
            "name": { "$fixture": "name" },
            "email_verified": true,
            "type": "access",
            "roles": { "$fixture": "roles" },
            "iat": { "$capture": "access-issued-at", "$predicate": "timestamp" },
            "exp": { "$capture": "access-expires-at", "$predicate": "timestamp" },
            "iss": "https://auth.financenow.kr",
            "aud": { "$fixture": "audience" }
          }
        }
      ],
      "stateAssertions": [{ "type": "refresh-rotation" }]
    },
    {
      "id": "security.refresh-hs384-algorithm",
      "fixture": "active-user-refresh-hs384",
