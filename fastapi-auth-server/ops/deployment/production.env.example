# OIDC/mail fragment only; merge into the private production configuration.
# Replace every hash/hostname; callbacks must match each real service registration.
NODE_ENV=production
OIDC_ENABLED=true
OIDC_PUBLIC_ORIGIN=https://auth.example.invalid
OIDC_CLIENTS_JSON='[{"clientId":"gitlab-temis","clientSecretHash":"REPLACE_WITH_ARGON2ID_HASH","redirectUris":["https://gitlab.example.invalid/users/auth/openid_connect/callback"],"allowedUserTypes":["EMPLOYEE"],"requiredRoles":[{"serviceKey":"gitlab","name":"user"}],"groupsServiceKeys":["gitlab"],"requirePkce":true,"ssoAutoLogin":true},{"clientId":"agent-hub-dash","clientSecretHash":"REPLACE_WITH_ARGON2ID_HASH","redirectUris":["https://hub.example.invalid/auth/callback"],"allowedUserTypes":["EMPLOYEE"],"requiredRoles":[{"serviceKey":"agent-hub","name":"user"}],"groupsServiceKeys":["agent-hub"],"requirePkce":true,"ssoAutoLogin":true},{"clientId":"fantra-oidc","clientSecretHash":"REPLACE_WITH_ARGON2ID_HASH","redirectUris":["https://fantra.example.invalid/auth/callback"],"allowedUserTypes":["CUSTOMER","EMPLOYEE"],"requiredRoles":[{"serviceKey":"temis","name":"user"}],"groupsServiceKeys":["temis"],"requirePkce":true,"ssoAutoLogin":true}]'
MAIL_PROVIDER=smtp
SMTP_HOST=REPLACE_WITH_REAL_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_PRIVATELY
SMTP_PASSWORD=REPLACE_PRIVATELY
# bash ops/check-prod-env.sh --env-file /private/path/production.env
