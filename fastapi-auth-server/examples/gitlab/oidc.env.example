# Documentation only: merge with the existing validated FastAPI configuration.
# Do not replace AUTH_CLIENTS_JSON or existing Cloudflare OIDC clients.
OIDC_ENABLED=false
OIDC_PUBLIC_ORIGIN=https://auth.financenow.kr
# OIDC_CLIENTS_JSON must be the complete JSON array including the rendered
# oidc-client.json entry. Replace its hash placeholder privately before loading.
