# NOT applied to /home/ruci/gitlab or a running GitLab instance.
# Review/merge with existing settings; never overwrite unrelated providers.
# Future approved external_url: https://gitlab.temis.me (routing/TLS not configured here).
gitlab_rails['omniauth_enabled'] = true
gitlab_rails['omniauth_allow_single_sign_on'] = ['openid_connect']
gitlab_rails['omniauth_block_auto_created_users'] = true
gitlab_rails['omniauth_auto_link_user'] = false
gitlab_rails['omniauth_auto_link_ldap_user'] = false

gitlab_rails['omniauth_providers'] = [
  {
    name: 'openid_connect',
    label: 'Wise SSO',
    args: {
      name: 'openid_connect',
      scope: ['openid', 'profile', 'email'],
      response_type: 'code',
      issuer: 'https://auth.financenow.kr',
      discovery: false,
      client_auth_method: 'basic',
      client_signing_alg: 'RS256',
      uid_field: 'sub',
      send_scope_to_token_endpoint: false,
      pkce: true,
      client_options: {
        identifier: 'gitlab-temis',
        secret: ENV.fetch('WISESSO_GITLAB_CLIENT_SECRET'),
        scheme: 'https',
        host: 'auth.financenow.kr',
        port: 443,
        authorization_endpoint: 'https://auth.financenow.kr/oauth2/authorize',
        token_endpoint: 'https://auth.financenow.kr/oauth2/token',
        userinfo_endpoint: 'https://auth.financenow.kr/oauth2/userinfo',
        jwks_uri: 'https://auth.financenow.kr/.well-known/jwks.json',
        redirect_uri: 'https://gitlab.temis.me/users/auth/openid_connect/callback'
      }
    }
  }
]
